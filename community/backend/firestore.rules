// Rehabwheel Community — development starter security rules.
// NOT DEPLOYED. Production release requires Firebase project, emulator tests,
// authentication, abuse/moderation services, security review and monitoring.
// Clinical/LegMaker telemetry or protected health information MUST NOT be stored here.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function safePrivateActivity(data) {
      return data.keys().hasOnly([
        'ownerId','sport','title','durationMin','createdAt','visibility'
      ])
      && data.ownerId is string
      && data.sport is string
      && data.sport.size() > 0
      && data.sport.size() <= 60
      && data.title is string
      && data.title.size() > 0
      && data.title.size() <= 72
      && data.durationMin is int
      && data.durationMin >= 1
      && data.durationMin <= 600
      && data.createdAt is timestamp
      && data.visibility == 'private';
    }
    // Profiles contain only account display preferences; never medical records.
    // Not publicly readable until field-level privacy is designed and tested.
    match /profiles/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['displayName','favoriteSports','visibility','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.visibility == 'private'
        && request.resource.data.favoriteSports is list
        && request.resource.data.favoriteSports.size() <= 12;
    }
    match /users/{uid}/activities/{activityId} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid) && safePrivateActivity(request.resource.data) && request.resource.data.ownerId == uid;
      allow update: if owns(uid)
        && resource.data.ownerId == uid
        && request.resource.data.ownerId == uid
        && safePrivateActivity(request.resource.data);
    }
    // Social publishing and club/admin writes must be mediated by trusted
    // backend code, validated moderation, and tested membership controls.
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if false;
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    match /feed/{postId} {
      allow read, write: if false;
    }
    match /messages/{messageId} {
      allow read, write: if false;
    }
    // Reports accepted via trusted moderation service only; do not expose raw
    // allegations or other users' reports to regular clients.
    match /reports/{reportId} {
      allow read, write: if false;
    }
    // Dedicated performance labs: invitation granted ONLY by trusted Admin SDK.
    // Do not store PHI or unreviewed clinical telemetry in these collections.
    function approvedLab(sportId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && sportId in ['mma', 'basketball']
        && exists(/databases/$(database)/documents/performanceLabs/$(sportId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/performanceLabs/$(sportId)/members/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/performanceLabs/$(sportId)/members/$(request.auth.uid)).data.role in ['admin', 'coach', 'analyst'];
    }
    match /performanceLabs/{sportId}/members/{uid} {
      // A signed-in, email-verified user can check their OWN invitation only.
      allow get: if owns(uid) && request.auth.token.email_verified == true
        && sportId in ['mma', 'basketball'];
      allow list, create, update, delete: if false;
    }
    match /performanceLabs/{sportId}/sessions/{sessionId} {
      allow get, list: if approvedLab(sportId);
      // Session creation and correction must go through a trusted backend.
      allow create, update, delete: if false;
    }
    match /performanceLabs/{sportId}/protocols/{protocolId} {
      allow get, list: if approvedLab(sportId);
      allow create, update, delete: if false;
    }
    // Never co-mingle clinical data with public sports profiles.
    match /clinical/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
